#!/usr/bin/env python3
"""Execute a single trusted Blocks program in a killable ROS process."""

import sys
import traceback
import uuid

import rospy
from std_msgs.msg import String
from clover_blocks.msg import Prompt


def main():
    namespace, filename = sys.argv[1:3]
    # Inherit the launch environment but not its __name remapping: registering
    # the worker under the parent's name would shut down the service node.
    rospy.init_node('clover_blocks_program', argv=[sys.argv[0]], anonymous=True, disable_signals=True)
    prefix = namespace.rstrip('/') + '/'
    print_pub = rospy.Publisher(prefix + 'print', String, queue_size=10, latch=True)
    block_pub = rospy.Publisher(prefix + 'block', String, queue_size=1, latch=True)
    prompt_pub = rospy.Publisher(prefix + 'prompt', Prompt, queue_size=10)
    error_pub = rospy.Publisher(prefix + 'error', String, queue_size=10, latch=True)

    def output(*values, **kwargs):
        text = kwargs.get('sep', ' ').join(str(value) for value in values)
        rospy.loginfo(text)
        print_pub.publish(text)

    def user_input(prompt=''):
        prompt_id = uuid.uuid4().hex
        prompt_pub.publish(message=str(prompt), id=prompt_id)
        return rospy.wait_for_message(prefix + 'input/' + prompt_id, String, timeout=30).data

    # Generated programs import rospy themselves. Keep init_node a no-op only
    # inside this worker; the parent retains an unmodified rospy module.
    rospy.init_node = lambda *args, **kwargs: None
    context = {'__name__': '__main__', 'rospy': rospy, '_b': block_pub.publish,
               'print': output, 'input': user_input, 'raw_input': user_input}
    try:
        with open(filename, encoding='utf-8') as source:
            code = compile(source.read(), '<clover_blocks_program>', 'exec')
        exec(code, context)
    except BaseException:
        error_pub.publish(traceback.format_exc())
        raise
    finally:
        # Allow final print/error messages to leave a short-lived worker.
        rospy.rostime.wallsleep(0.2)


if __name__ == '__main__':
    main()
